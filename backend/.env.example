# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://criminal_scene:change-me@db:5432/criminal_scene
DATABASE_URL=sqlite:///./criminal_scene.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
# M1 controlled storage and point-cloud tools. Do not serve STORAGE_ROOT statically.
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=1073741824
PDAL_PATH=pdal
POTREE_CONVERTER_PATH=PotreeConverter
CONVERSION_TIMEOUT_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=pointcloud
